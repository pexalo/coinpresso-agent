# ---------------------------------------------------------------------------
# Coinpresso agent — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Uncomment and fill both to run live. Left commented (or left as the placeholder
# text), the app stays in mock mode — which is deliberate, so that copying this
# file does not produce a build that thinks it has keys and fails on a 401
# three minutes into the first run.

# Strategy agent (research + web search) and Writer agent.
# ANTHROPIC_API_KEY=

# Review agent (style + compliance enforcement).
# OPENAI_API_KEY=

# Model selection. Defaults are set in src/lib/models.ts — override here only
# if you want to move a stage up or down a tier.
# STRATEGY_MODEL=claude-sonnet-4-5
# WRITER_MODEL=claude-sonnet-4-5
# REVIEWER_MODEL=gpt-4.1

# Optional. When unset the app runs in MOCK mode: the full pipeline executes
# with canned agent responses so the dashboard is explorable without spend.
# Set to "1" to force mock even when keys are present.
# MOCK_AGENTS=1

# Google export (optional — approval step writes a Doc and updates the calendar).
# Service account JSON, base64-encoded, with Docs + Sheets + Drive scope.
# GOOGLE_SERVICE_ACCOUNT_B64=
# CONTENT_CALENDAR_SHEET_ID=1WBmkWxbpfeORG_uL8Kl9JAGdYcVjh5qaBA61qstbMmc
# GOOGLE_DRIVE_FOLDER_ID=
